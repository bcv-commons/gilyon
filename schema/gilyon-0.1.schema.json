{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gilyon.org/0.1/schema.json",
  "title": "Gilyon — Bible Annotation Exchange Format, version 0.1",
  "description": "Structural validation only. Rules that depend on a base text (canonical order, word existence) or on other members across the document are stated in the specification and checked by tools/validate.py. That an annotation has a body where one is required (spec §6.1) is checked by the validator, because it depends on the document's `bodies` member.",
  "type": "object",
  "required": [
    "gilyon",
    "conformsTo",
    "id",
    "meta",
    "texts",
    "annotations"
  ],
  "properties": {
    "@context": {},
    "gilyon": {
      "const": "0.1"
    },
    "conformsTo": {
      "enum": [
        0,
        1,
        2
      ]
    },
    "id": {
      "$ref": "#/$defs/iri"
    },
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "texts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/localName"
      },
      "additionalProperties": {
        "$ref": "#/$defs/text"
      }
    },
    "annotations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/annotation"
      }
    },
    "bodies": {
      "enum": [
        "inline",
        "separate"
      ]
    }
  },
  "$defs": {
    "iri": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:\\S+$"
    },
    "localName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}([Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?([Zz]|[+-][0-9]{2}:[0-9]{2}))?$"
    },
    "languageTag": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
    },
    "languageMap": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/languageTag"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "label": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/languageMap"
        }
      ]
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "approved",
        "withdrawn"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reference": {
      "type": "string",
      "pattern": "^[A-Z0-9]{3}( [0-9]{1,3}(:([0-9]{1,3}[a-z]?|title))?(-([0-9]{1,3}:)?([0-9]{1,3}[a-z]?|title))?)?$"
    },
    "wordId": {
      "type": "string",
      "pattern": "^(o[0-9]{12}|n[0-9]{11})$"
    },
    "lexemeId": {
      "type": "string",
      "pattern": "^(hbo|arc):[0-9]{4}[a-z]?$|^grc:[1-9][0-9]{0,3}[a-z]?$"
    },
    "agent": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/iri"
        },
        "type": {
          "enum": [
            "Person",
            "Organization",
            "Software"
          ]
        },
        "version": {
          "type": "string"
        },
        "email": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "required": [
            "name"
          ]
        },
        {
          "required": [
            "id"
          ]
        }
      ]
    },
    "agents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/agent"
      },
      "minItems": 1
    },
    "meta": {
      "type": "object",
      "required": [
        "license"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/label"
        },
        "description": {
          "$ref": "#/$defs/label"
        },
        "language": {
          "$ref": "#/$defs/languageTag"
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "licenseUrl": {
          "$ref": "#/$defs/iri"
        },
        "attribution": {
          "type": "string"
        },
        "creator": {
          "$ref": "#/$defs/agents"
        },
        "publisher": {
          "$ref": "#/$defs/agent"
        },
        "created": {
          "$ref": "#/$defs/timestamp"
        },
        "modified": {
          "$ref": "#/$defs/timestamp"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "source": {
          "type": "object"
        },
        "generator": {
          "$ref": "#/$defs/agent"
        }
      }
    },
    "text": {
      "type": "object",
      "required": [
        "role"
      ],
      "properties": {
        "role": {
          "enum": [
            "base",
            "reference"
          ]
        },
        "title": {
          "type": "string"
        },
        "versification": {
          "type": "string",
          "minLength": 1
        },
        "release": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "license": {
          "type": "string"
        },
        "url": {
          "$ref": "#/$defs/iri"
        },
        "edition": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "base"
              }
            }
          },
          "then": {
            "required": [
              "edition",
              "release"
            ],
            "not": {
              "required": [
                "versification"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "reference"
              }
            }
          },
          "then": {
            "required": [
              "versification"
            ]
          }
        }
      ]
    },
    "wordHints": {
      "properties": {
        "check": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/wordId"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "lexemes": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/wordId"
          },
          "additionalProperties": {
            "$ref": "#/$defs/lexemeId"
          }
        }
      }
    },
    "selector": {
      "type": "object",
      "required": [
        "type"
      ],
      "oneOf": [
        {
          "$ref": "#/$defs/selPassage"
        },
        {
          "$ref": "#/$defs/selWords"
        },
        {
          "$ref": "#/$defs/selRange"
        },
        {
          "$ref": "#/$defs/selPoint"
        },
        {
          "$ref": "#/$defs/selLexeme"
        },
        {
          "$ref": "#/$defs/selComposite"
        }
      ]
    },
    "selPassage": {
      "required": [
        "ref"
      ],
      "properties": {
        "type": {
          "const": "Passage"
        },
        "ref": {
          "$ref": "#/$defs/reference"
        }
      }
    },
    "selWords": {
      "required": [
        "words"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/wordHints"
        }
      ],
      "properties": {
        "type": {
          "const": "Words"
        },
        "ref": {
          "$ref": "#/$defs/reference"
        },
        "words": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/wordId"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "selRange": {
      "required": [
        "first",
        "last"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/wordHints"
        }
      ],
      "properties": {
        "type": {
          "const": "Range"
        },
        "ref": {
          "$ref": "#/$defs/reference"
        },
        "first": {
          "$ref": "#/$defs/wordId"
        },
        "last": {
          "$ref": "#/$defs/wordId"
        }
      }
    },
    "selPoint": {
      "anyOf": [
        {
          "required": [
            "after"
          ]
        },
        {
          "required": [
            "before"
          ]
        }
      ],
      "allOf": [
        {
          "$ref": "#/$defs/wordHints"
        }
      ],
      "properties": {
        "type": {
          "const": "Point"
        },
        "ref": {
          "$ref": "#/$defs/reference"
        },
        "after": {
          "$ref": "#/$defs/wordId"
        },
        "before": {
          "$ref": "#/$defs/wordId"
        }
      }
    },
    "selLexeme": {
      "required": [
        "lexeme"
      ],
      "properties": {
        "type": {
          "const": "Lexeme"
        },
        "lexeme": {
          "$ref": "#/$defs/lexemeId"
        },
        "sense": {
          "type": "object",
          "required": [
            "inventory",
            "id"
          ],
          "properties": {
            "inventory": {
              "type": "string"
            },
            "id": {
              "type": "string"
            }
          }
        }
      }
    },
    "selComposite": {
      "required": [
        "items"
      ],
      "properties": {
        "type": {
          "const": "Composite"
        },
        "ref": {
          "$ref": "#/$defs/reference"
        },
        "items": {
          "type": "array",
          "minItems": 2,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/selector"
              },
              {
                "not": {
                  "properties": {
                    "type": {
                      "const": "Composite"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "anchoring": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "authored",
            "reviewed",
            "derived",
            "unresolved"
          ]
        },
        "method": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tier": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "detail": {
          "type": "string"
        },
        "reviewer": {
          "$ref": "#/$defs/agent"
        },
        "date": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "derived"
          }
        }
      },
      "then": {
        "required": [
          "method"
        ]
      }
    },
    "target": {
      "type": "object",
      "properties": {
        "text": {
          "$ref": "#/$defs/localName"
        },
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "anchoring": {
          "$ref": "#/$defs/anchoring"
        },
        "origin": false,
        "fallback": {
          "$ref": "#/$defs/selPassage"
        },
        "annotation": {
          "$ref": "#/$defs/iri"
        }
      },
      "oneOf": [
        {
          "required": [
            "annotation"
          ],
          "not": {
            "required": [
              "selector"
            ]
          }
        },
        {
          "required": [
            "selector"
          ],
          "not": {
            "required": [
              "annotation"
            ]
          }
        }
      ]
    },
    "body": {
      "type": "object",
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "language": {
          "$ref": "#/$defs/languageTag"
        },
        "format": {
          "enum": [
            "text/plain",
            "text/markdown",
            "text/html"
          ]
        },
        "purpose": {
          "type": "string"
        },
        "translationOf": {
          "$ref": "#/$defs/languageTag"
        },
        "creator": {
          "$ref": "#/$defs/agents"
        },
        "license": {
          "type": "string"
        },
        "translation": {
          "$ref": "#/$defs/translation"
        }
      }
    },
    "bodies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/body"
      },
      "minItems": 1
    },
    "link": {
      "type": "object",
      "required": [
        "rel"
      ],
      "properties": {
        "rel": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "entity": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*:\\S+$"
        },
        "url": {
          "$ref": "#/$defs/iri"
        },
        "label": {
          "$ref": "#/$defs/label"
        }
      },
      "oneOf": [
        {
          "required": [
            "target"
          ]
        },
        {
          "required": [
            "entity"
          ]
        },
        {
          "required": [
            "url"
          ]
        }
      ]
    },
    "unitId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._'-]+$"
    },
    "structure": {
      "type": "object",
      "required": [
        "units"
      ],
      "properties": {
        "units": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "selector"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/unitId"
              },
              "label": {
                "type": "string"
              },
              "selector": {
                "$ref": "#/$defs/selector"
              },
              "key": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/selector"
                }
              },
              "level": {
                "type": "integer",
                "minimum": 0
              },
              "parent": {
                "$ref": "#/$defs/unitId"
              },
              "body": {
                "$ref": "#/$defs/bodies"
              }
            }
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "units"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "units": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/unitId"
                },
                "minItems": 2
              },
              "body": {
                "$ref": "#/$defs/bodies"
              }
            }
          }
        },
        "focus": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unitId"
          },
          "minItems": 1
        },
        "notation": {
          "type": "string"
        }
      }
    },
    "annotation": {
      "type": "object",
      "required": [
        "id",
        "motivation",
        "target"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/iri"
        },
        "motivation": {
          "enum": [
            "commenting",
            "describing",
            "classifying",
            "linking",
            "identifying",
            "highlighting",
            "questioning",
            "replying",
            "assessing",
            "editing"
          ]
        },
        "category": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9._/-]+$"
          },
          "uniqueItems": true
        },
        "body": {
          "$ref": "#/$defs/bodies"
        },
        "target": {
          "oneOf": [
            {
              "$ref": "#/$defs/target"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/target"
              },
              "minItems": 1
            }
          ]
        },
        "structure": {
          "$ref": "#/$defs/structure"
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "creator": {
          "$ref": "#/$defs/agents"
        },
        "created": {
          "$ref": "#/$defs/timestamp"
        },
        "modified": {
          "$ref": "#/$defs/timestamp"
        },
        "license": {
          "type": "string"
        },
        "attribution": {
          "type": "string"
        },
        "source": {
          "type": "object"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "supersedes": {
          "$ref": "#/$defs/iri"
        },
        "presentation": {
          "type": "object",
          "properties": {
            "color": {
              "type": "string"
            },
            "caller": {
              "type": "string"
            },
            "placement": {
              "enum": [
                "inline",
                "footnote",
                "margin",
                "sidebar",
                "introduction"
              ]
            }
          }
        },
        "sequence": {
          "type": "number"
        }
      }
    },
    "translation": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "machine",
            "reviewed",
            "human"
          ]
        },
        "sourceDigest": {
          "$ref": "#/$defs/sha256"
        },
        "method": {
          "type": "string"
        },
        "reviewer": {
          "$ref": "#/$defs/agent"
        },
        "date": {
          "type": "string"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gilyon.org/0.1/manifest.schema.json",
  "title": "Gilyon 0.1 — manifest of a collection (spec §16.1), of one part of a collection (§16.1, Parts) or of a translation of one (§16.3)",
  "description": "Structural validation only. That the listed files exist, match their hashes and agree with the manifest is checked by tools/validate.py.",
  "type": "object",
  "required": [
    "gilyon"
  ],
  "properties": {
    "gilyon": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:\\S+$"
    },
    "title": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      ]
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "attribution": {
      "type": "string"
    },
    "texts": {
      "type": "object"
    },
    "created": {
      "type": "string"
    },
    "modified": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "books": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[A-Z0-9]{3}$"
            }
          },
          "id": {
            "type": "string"
          },
          "ref": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          },
          "annotations": {
            "type": "integer",
            "minimum": 0
          },
          "bodies": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
            },
            "additionalProperties": {
              "type": "object",
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "id": {
                  "type": "string"
                },
                "entries": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "sourceLanguage": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
    },
    "languages": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "dir"
        ],
        "properties": {
          "dir": {
            "type": "string",
            "pattern": "^[a-z]{3}(-[A-Za-z0-9]{1,8})*$"
          },
          "title": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            ]
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "attribution": {
            "type": "string"
          },
          "translation": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "machine",
                  "reviewed",
                  "human",
                  "mixed"
                ]
              },
              "method": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "of": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:\\S+$"
    },
    "ofManifest": {
      "type": "string",
      "minLength": 1
    },
    "ofSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "books"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "books": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[A-Z0-9]{3}$"
            }
          },
          "files": {
            "type": "integer",
            "minimum": 0
          },
          "annotations": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "partOf": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:\\S+$"
    },
    "partOfManifest": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    }
  },
  "if": {
    "required": [
      "of"
    ]
  },
  "then": {
    "required": [
      "id",
      "license",
      "files",
      "languages"
    ],
    "properties": {
      "texts": false,
      "sourceLanguage": false,
      "files": {
        "items": {
          "required": [
            "id",
            "bodies"
          ],
          "properties": {
            "path": false,
            "books": false,
            "sha256": false
          }
        }
      },
      "parts": false,
      "partOf": false,
      "partOfManifest": false
    }
  },
  "else": {
    "if": {
      "required": [
        "partOf"
      ]
    },
    "then": {
      "required": [
        "partOf",
        "files"
      ],
      "properties": {
        "files": {
          "items": {
            "required": [
              "path",
              "sha256",
              "books"
            ]
          }
        },
        "license": false,
        "texts": false,
        "languages": false,
        "sourceLanguage": false,
        "parts": false,
        "of": false,
        "ofManifest": false,
        "ofSha256": false,
        "attribution": false
      }
    },
    "else": {
      "required": [
        "id",
        "license",
        "texts"
      ],
      "dependentRequired": {
        "languages": [
          "sourceLanguage"
        ],
        "sourceLanguage": [
          "languages"
        ]
      },
      "properties": {
        "ofManifest": false,
        "files": {
          "items": {
            "required": [
              "path",
              "sha256",
              "books"
            ]
          }
        },
        "ofSha256": false,
        "partOf": false,
        "partOfManifest": false
      },
      "oneOf": [
        {
          "required": [
            "files"
          ]
        },
        {
          "required": [
            "parts"
          ]
        }
      ]
    }
  }
}

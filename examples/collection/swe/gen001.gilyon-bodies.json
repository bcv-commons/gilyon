    },
    {
      "annotation": "urn:uuid:d42e12b0-a6ff-53f0-bacb-fb074bf3bd6e",
      "body": [
        {
          "value": "Början; den första eller bästa delen av något. Noten gäller överallt där lexemet förekommer.",
          "translation": {

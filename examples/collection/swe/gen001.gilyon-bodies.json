    },
    {
      "annotation": "urn:uuid:31155b51-21cc-56f6-9c28-0246e3995354",
      "body": [
        {
          "value": "De två hebreiska orden rimmar (tohu wa-bohu). Få översättningar behåller klangen.",
          "translation": {
            "sourceDigest": "bf2db6aaf977d0eca4d89cd89b6f2f92ba328d32981eaaeedddc1b8202148866"
          }
        }

      "annotation": "urn:uuid:b962819f-00fd-5a6a-b602-58fb9ffc18b5",
      "body": [
        {
          "value": "Två ytterligheter nämns för att beteckna allt som ligger mellan dem: allt som finns.",
          "translation": {
            "sourceDigest": "861765f32fd3460d04530863418c2e11e2f4799da6c5a3e5f597754099bbf2bb"
          }
